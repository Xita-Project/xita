// ---------------------------------------------------------------------------
//  XboxVita Stage 3b - auto-generated Vita Cg fragment shader: ps_AE2D2C33_3D
//  source def: VA None  file 0x0
//  2 combiner stage(s); textures t0:PROJECT2D t1:PROJECT2D t2:PROJECT2D t3:CUBEMAP
//  Uniforms: psc[16] = SetPixelShaderConstant regs; xv_fogcolor.rgb; fog factor = TEXCOORD7
//    stage 0 rgb  : t0 = dot(t0.rgb<expand_normal>, t3.rgb<expand_normal>); r0 = t2.rgb * c0.rgb
//    stage 0 alpha: (discard)
//    stage 1 rgb  : (discard)
//    stage 1 alpha: r0 = sum(v0.a<unsigned_invert> * zero.b<unsigned_invert>, v0.a * t0.b)
//    final rgb  : t2.rgb * ef_prod.rgb + (1 - t2.rgb) * zero.rgb + r0.rgb
//    final alpha: t0.a
//    final ef_prod = r0.aaa * c0.rgb
// ---------------------------------------------------------------------------

struct VertOut
{
    float4 position    : POSITION;
    float4 color0      : COLOR0;
    float4 texcoord0   : TEXCOORD0;
    float4 texcoord1   : TEXCOORD1;
    float4 texcoord2   : TEXCOORD2;
    float4 texcoord3   : TEXCOORD3;
};

float4 main(VertOut IN, uniform sampler2D tex0, uniform sampler2D tex1, uniform sampler2D tex2, uniform float4 psc[18], uniform float4 xv_fogcolor) : COLOR
{
    // ---- inputs (varyings the vertex program does not write read as NV2A defaults)
    float4 v0 = IN.color0, v1 = float4(0.0, 0.0, 0.0, 0.0);
    float4 fog = float4(xv_fogcolor.rgb, 1.0);
    float4 r0 = float4(0.0, 0.0, 0.0, 0.0), r1 = float4(0.0, 0.0, 0.0, 0.0);
    float4 t0 = tex2D(tex0, IN.texcoord0.xy);
    float4 t1 = tex2D(tex1, IN.texcoord1.xy);
    float4 t2 = tex2D(tex2, IN.texcoord2.xy);
    float4 t3 = float4(normalize(IN.texcoord3.xyz) * 0.5 + 0.5, 1.0);   // normalisation cube map -> analytic
    // ---- combiner stage 0
    {
        float3 A = (2.0 * max(t0.rgb, 0.0) - 1.0), B = (2.0 * max(t3.rgb, 0.0) - 1.0), C = saturate(t2.rgb), D = saturate(psc[0].rgb);
        float3 AB = float3(dot(A, B));
        float3 CD = C * D;
        float3 SUM = AB + CD;
        float  a_A = saturate(float4(0.0, 0.0, 0.0, 0.0).b), a_B = saturate(float4(0.0, 0.0, 0.0, 0.0).b), a_C = saturate(float4(0.0, 0.0, 0.0, 0.0).b), a_D = saturate(float4(0.0, 0.0, 0.0, 0.0).b);
        float  a_AB = a_A * a_B, a_CD = a_C * a_D;
        float  a_SUM = a_AB + a_CD;
        t0.rgb = clamp(AB, -1.0, 1.0);
        r0.rgb = clamp(CD, -1.0, 1.0);
    }
    // ---- combiner stage 1
    {
        float3 A = saturate(float4(0.0, 0.0, 0.0, 0.0).rgb), B = saturate(float4(0.0, 0.0, 0.0, 0.0).rgb), C = saturate(float4(0.0, 0.0, 0.0, 0.0).rgb), D = saturate(float4(0.0, 0.0, 0.0, 0.0).rgb);
        float3 AB = A * B;
        float3 CD = C * D;
        float3 SUM = AB + CD;
        float  a_A = (1.0 - saturate(v0.a)), a_B = (1.0 - saturate(float4(0.0, 0.0, 0.0, 0.0).b)), a_C = saturate(v0.a), a_D = saturate(t0.b);
        float  a_AB = a_A * a_B, a_CD = a_C * a_D;
        float  a_SUM = a_AB + a_CD;
        r0.a = clamp(a_SUM, -1.0, 1.0);
    }
    // ---- final combiner
    float4 v1r0_sum = float4(v1.rgb + r0.rgb, 0.0);
    float4 ef_prod = float4(saturate(r0.aaa) * saturate(psc[16].rgb), 0.0);
    float3 FA = saturate(t2.rgb), FB = saturate(ef_prod.rgb), FC = saturate(float4(0.0, 0.0, 0.0, 0.0).rgb), FD = saturate(r0.rgb);
    float3 out_rgb = FA * FB + (1.0 - FA) * FC + FD;
    float  out_a   = saturate(t0.a);
    return saturate(float4(out_rgb, out_a));
}
