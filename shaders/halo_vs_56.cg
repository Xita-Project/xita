// ---------------------------------------------------------------------------
//  XboxVita Stage 3 - auto-generated Vita Cg vertex shader
//  source : halo_vs_56.json
//  mode   : NV2A microcode translation
//  target : psp2cgc -profile sce_vp_psp2
//
//  Uniform contract:
//    uniform float4 c[4]  - universal constant array, C_BASE = -68
//    runtime maps SetVertexShaderConstant(reg, v) -> c[reg - C_BASE]
//    microcode uses D3D c-68..c-65 (hardware c[28]..)
//    7 of 9 NV2A slots translated; inputs v0 v4 v9 v10; outputs oPos oD0 oD1 oT0
//    slots [7, 8] = Xbox viewport epilogue, stripped (pass --keep-viewport-epilogue to translate verbatim)
//  Attribute binding (sceGxmVertexAttribute regIndex from parameter name):
//    v0  position    float3 FLOAT3      stream 0 +0 (12 B)
//    v4  color1      float2 FLOAT2      stream 0 +12 (8 B)
//    v9  texcoord0   float4 D3DCOLOR    stream 0 +20 (4 B)  // U8N x4 in memory order B,G,R,A -> swizzled to RGBA
//    v10 texcoord1   float4 FLOAT4      not in declaration
//  Depth: D3D clip z in [0, w] is passed through unchanged; set the GXM viewport
//         with zOffset = 0, zScale = 1 (no [-1,1] -> [0,1] remap) to match.
// ---------------------------------------------------------------------------

struct AppIn
{
    float3 position    : POSITION;   // v0 FLOAT3
    float2 color1      : COLOR1;   // v4 FLOAT2
    float4 texcoord0   : TEXCOORD0;   // v9 D3DCOLOR
    float4 texcoord1   : TEXCOORD1;   // v10 FLOAT4
};

struct VertOut
{
    float4 position    : POSITION;   // oPos
    float4 color0      : COLOR0;   // oD0
    float4 color1      : COLOR1;   // oD1
    float4 texcoord0   : TEXCOORD0;   // oT0
};

float4 xv_dph(float4 a, float4 b) { return float4(dot(a.xyz, b.xyz) + b.w); }

VertOut main(AppIn IN, uniform float4 c[4])
{
    VertOut OUT;
    // --- attribute loads (expanded to float4 exactly as the NV2A input file presents them)
    float4 v0 = float4(IN.position, 1.0);
    float4 v4 = float4(IN.color1, 0.0, 1.0);
    float4 v9 = IN.texcoord0.zyxw;   // U8N x4 in memory order B,G,R,A -> swizzled to RGBA
    float4 v10 = IN.texcoord1;   // not in declaration

    // --- register file
    float4 oPos = float4(0.0, 0.0, 0.0, 1.0), oD0 = float4(0.0, 0.0, 0.0, 0.0), oD1 = float4(0.0, 0.0, 0.0, 0.0), oT0 = float4(0.0, 0.0, 0.0, 0.0);

    // --- program (one NV2A slot per block; MAC and ILU read before either writes)
    // [00] dph oPos.x, v0, c[28]
    {
        float4 m = xv_dph(v0, c[0]);
        oPos.x = m.x;
    }
    // [01] dph oPos.y, v0, c[29]
    {
        float4 m = xv_dph(v0, c[1]);
        oPos.y = m.y;
    }
    // [02] dph oPos.z, v0, c[30]
    {
        float4 m = xv_dph(v0, c[2]);
        oPos.z = m.z;
    }
    // [03] dph oPos.w, v0, c[31]
    {
        float4 m = xv_dph(v0, c[3]);
        oPos.w = m.w;
    }
    // [04] mov oT0.xy, v4
    {
        float4 m = v4;
        oT0.xy = m.xy;
    }
    // [05] mov oD0, v9
    {
        float4 m = v9;
        oD0 = m;
    }
    // [06] mov oD1.w, v10.x
    {
        float4 m = v10.xxxx;
        oD1.w = m.w;
    }
    // [07] mul oPos.xyz, r12, c[58] | rcc r1.x, r12.w    <- stripped: Xbox viewport epilogue (GXM divides by w)
    // [08] mad oPos.xyz, r12, r1.x, c[59]    <- stripped: Xbox viewport epilogue (GXM divides by w)

    // --- outputs
    OUT.position = oPos;
    OUT.color0 = oD0;
    OUT.color1 = oD1;
    OUT.texcoord0 = oT0;
    return OUT;
}

