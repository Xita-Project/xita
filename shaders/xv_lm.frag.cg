// Xita runtime fragment shader: Halo environment approximation, base (t0, oT0) x lightmap (t2, oT2) x 2.
struct VertOut
{
    float4 position  : POSITION;
    float4 texcoord0 : TEXCOORD0;
    float4 texcoord2 : TEXCOORD2;
};

float4 main(VertOut IN, uniform sampler2D tex0, uniform sampler2D tex2, uniform float4 xv_atest) : COLOR
{
    float4 b = tex2D(tex0, IN.texcoord0.xy);
    float4 l = tex2D(tex2, IN.texcoord2.xy);
    float4 c_ = float4(b.rgb * l.rgb * 2.0, b.a);
    // ---- alpha test (NV097_SET_ALPHA_TEST_ENABLE/FUNC/REF): xv_atest = (ref, func 0..7, enable, 0)
    if (xv_atest.z > 0.5) {
        float a_ = saturate(c_.a); float r_ = xv_atest.x; float f_ = xv_atest.y;
        bool pass_ = (f_ > 6.5) || (f_ > 3.5 && f_ < 4.5 && a_ > r_) || (f_ > 5.5 && f_ < 6.5 && a_ >= r_)
                  || (f_ > 0.5 && f_ < 1.5 && a_ < r_) || (f_ > 2.5 && f_ < 3.5 && a_ <= r_)
                  || (f_ > 1.5 && f_ < 2.5 && abs(a_ - r_) < 0.002) || (f_ > 4.5 && f_ < 5.5 && abs(a_ - r_) >= 0.002);
        if (!pass_) discard;
    }
    return c_;
}
