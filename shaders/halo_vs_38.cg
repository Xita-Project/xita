// ---------------------------------------------------------------------------
//  Xita Stage 3 - auto-generated Vita Cg vertex shader
//  source : halo_vs_38.json
//  mode   : NV2A microcode translation
//  target : psp2cgc -profile sce_vp_psp2
//
//  Uniform contract:
//    uniform float4 c[8]  - universal constant array, C_BASE = -81
//    runtime maps SetVertexShaderConstant(reg, v) -> c[reg - C_BASE]
//    microcode uses D3D c-81..c-74 (hardware c[15]..)
//    9 of 11 NV2A slots translated; inputs v0 v4; outputs oPos oT0 oT1 oT2 oT3
//    slots [9, 10] = Xbox viewport epilogue, stripped (pass --keep-viewport-epilogue to translate verbatim)
//  Attribute binding (sceGxmVertexAttribute regIndex from parameter name):
//    v0  position    float2 FLOAT2      stream 0 +0 (8 B)
//    v4  color1      float2 FLOAT2      stream 0 +8 (8 B)
//    v9  texcoord0   float4 D3DCOLOR    stream 0 +16 (4 B)  // U8N x4 in memory order B,G,R,A -> swizzled to RGBA
//  Depth: D3D clip z in [0, w] is passed through unchanged; set the GXM viewport
//         with zOffset = 0, zScale = 1 (no [-1,1] -> [0,1] remap) to match.
// ---------------------------------------------------------------------------

struct AppIn
{
    float2 position    : POSITION;   // v0 FLOAT2
    float2 color1      : COLOR1;   // v4 FLOAT2
    float4 texcoord0   : TEXCOORD0;   // v9 D3DCOLOR
};

struct VertOut
{
    float4 position    : POSITION;   // oPos
    float4 texcoord0   : TEXCOORD0;   // oT0
    float4 texcoord1   : TEXCOORD1;   // oT1
    float4 texcoord2   : TEXCOORD2;   // oT2
    float4 texcoord3   : TEXCOORD3;   // oT3
};

float4 xv_dph(float4 a, float4 b) { return float4(dot(a.xyz, b.xyz) + b.w); }

VertOut main(AppIn IN, uniform float4 c[8])
{
    VertOut OUT;
    // --- attribute loads (expanded to float4 exactly as the NV2A input file presents them)
    float4 v0 = float4(IN.position, 0.0, 1.0);
    float4 v4 = float4(IN.color1, 0.0, 1.0);

    // --- register file
    float4 oPos = float4(0.0, 0.0, 0.0, 1.0), oT0 = float4(0.0, 0.0, 0.0, 0.0), oT1 = float4(0.0, 0.0, 0.0, 0.0), oT2 = float4(0.0, 0.0, 0.0, 0.0), oT3 = float4(0.0, 0.0, 0.0, 0.0);

    // --- program (one NV2A slot per block; MAC and ILU read before either writes)
    // [00] mov oPos.xy, v0
    {
        float4 m = v0;
        oPos.xy = m.xy;
    }
    // [01] dph oT0.x, v4, c[15]
    {
        float4 m = xv_dph(v4, c[0]);
        oT0.x = m.x;
    }
    // [02] dph oT0.y, v4, c[16]
    {
        float4 m = xv_dph(v4, c[1]);
        oT0.y = m.y;
    }
    // [03] dph oT1.x, v4, c[17]
    {
        float4 m = xv_dph(v4, c[2]);
        oT1.x = m.x;
    }
    // [04] dph oT1.y, v4, c[18]
    {
        float4 m = xv_dph(v4, c[3]);
        oT1.y = m.y;
    }
    // [05] dph oT2.x, v4, c[19]
    {
        float4 m = xv_dph(v4, c[4]);
        oT2.x = m.x;
    }
    // [06] dph oT2.y, v4, c[20]
    {
        float4 m = xv_dph(v4, c[5]);
        oT2.y = m.y;
    }
    // [07] dph oT3.x, v4, c[21]
    {
        float4 m = xv_dph(v4, c[6]);
        oT3.x = m.x;
    }
    // [08] dph oT3.y, v4, c[22]
    {
        float4 m = xv_dph(v4, c[7]);
        oT3.y = m.y;
    }
    // [09] mul oPos.xyz, r12, c[58] | rcc r1.x, r12.w    <- stripped: Xbox viewport epilogue (GXM divides by w)
    // [10] mad oPos.xyz, r12, r1.x, c[59]    <- stripped: Xbox viewport epilogue (GXM divides by w)

    // --- outputs
    OUT.position = float4(oPos.xy, oPos.z * 0.9999, oPos.w);   /* keep z < w: Halo puts the sky exactly on the far plane and GXM clips z == w away */
    OUT.texcoord0 = oT0;
    OUT.texcoord1 = oT1;
    OUT.texcoord2 = oT2;
    OUT.texcoord3 = oT3;
    return OUT;
}

