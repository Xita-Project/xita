    {
        float4 m = r11.zzzz * c[24] + r6;
        r5.xyz = m.xyz;
    }
    // [51] mad oD0.xyz, r11.w, c[26], r5
    {
        float4 m = r11.wwww * c[26] + r5;
        oD0.xyz = m.xyz;
    }
    // [52] dph oPos.z, r10, c[2]
    {
        float4 m = xv_dph(r10, c[2]);
        oPos.z = m.z;
    }
    // [53] dph oPos.w, r10, c[3]
    {
        float4 m = xv_dph(r10, c[3]);
        oPos.w = m.w;
    }
    // [54] dph oT0.y, v4, c[16]
    {
        float4 m = xv_dph(v4, c[16]);
        oT0.y = m.y;
    }
