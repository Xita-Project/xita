    // [64] add r7.xy, v4.w, -r6
    {
        float4 m = v4.wwww + -r6;
        r7.xy = m.xy;
    }
    // [65] mul oPos.xyz, r12, c[58] | rcc r1.x, r12.w    <- stripped: Xbox viewport epilogue (GXM divides by w)
    // [66] max r8.xyz, r7, v4.z
    {
        float4 m = max(r7, v4.zzzz);
