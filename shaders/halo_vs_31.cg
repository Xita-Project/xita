    }
    // [69] add r10.x, r9.x, r9.y
    {
        float4 m = r9.xxxx + r9.yyyy;
        r10.x = m.x;
    }
    // [70] mul r4.z, r9.z, c[11].x
    {
        float4 m = r9.zzzz * c[11].xxxx;
