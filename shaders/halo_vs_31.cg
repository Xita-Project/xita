    {
        float4 m = r5.xxxx * c[19] + r3;
        r4.xyz = m.xyz;
    }
    // [49] mad r6.xyz, r5.y, c[22], r4
    {
        float4 m = r5.yyyy * c[22] + r4;
        r6.xyz = m.xyz;
