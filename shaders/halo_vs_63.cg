// ---------------------------------------------------------------------------
//  Xita Stage 3 - auto-generated Vita Cg vertex shader
//  source : halo_vs_63.json
//  mode   : NV2A microcode translation
//  target : psp2cgc -profile sce_vp_psp2
//
//  Uniform contract:
//    uniform float4 c[192]  - universal constant array, C_BASE = -96
//    runtime maps SetVertexShaderConstant(reg, v) -> c[reg - C_BASE]
//    microcode uses D3D c-96..c95 (hardware c[0]..)
//    55 of 57 NV2A slots translated; inputs v0 v1 v2 v3 v4 v5 v6; outputs oPos oD0 oT0 oT1 oT2 oT3
//    slots [42, 50] = Xbox viewport epilogue, stripped (pass --keep-viewport-epilogue to translate verbatim)
//  Attribute binding (sceGxmVertexAttribute regIndex from parameter name):
//    v0  position    float3 FLOAT3      stream 0 +0 (12 B)
//    v1  blendweight float4 NORMPACKED3 stream 0 +12 (4 B)  // bind as U8 x4 (raw bytes); unpacked in-shader
//    v2  normal      float4 NORMPACKED3 stream 0 +16 (4 B)  // bind as U8 x4 (raw bytes); unpacked in-shader
//    v3  color0      float4 NORMPACKED3 stream 0 +20 (4 B)  // bind as U8 x4 (raw bytes); unpacked in-shader
//    v4  color1      float2 NORMSHORT2  stream 0 +24 (4 B)  // S16N
//    v5  fog         float2 PBYTE2      stream 0 +28 (2 B)  // U8N
//    v6  psize       float  NORMSHORT1  stream 0 +30 (2 B)  // S16N
//  Depth: D3D clip z in [0, w] is passed through unchanged; set the GXM viewport
//         with zOffset = 0, zScale = 1 (no [-1,1] -> [0,1] remap) to match.
// ---------------------------------------------------------------------------

struct AppIn
{
    float3 position    : POSITION;   // v0 FLOAT3
    float4 blendweight : BLENDWEIGHT;   // v1 NORMPACKED3
    float4 normal      : NORMAL;   // v2 NORMPACKED3
    float4 color0      : COLOR0;   // v3 NORMPACKED3
    float2 color1      : COLOR1;   // v4 NORMSHORT2
    float2 fog         : TEXCOORD4;   // v5 PBYTE2
    float  psize       : TEXCOORD5;   // v6 NORMSHORT1
};

struct VertOut
{
    float4 position    : POSITION;   // oPos
    float4 color0      : COLOR0;   // oD0
    float4 texcoord0   : TEXCOORD0;   // oT0
    float4 texcoord1   : TEXCOORD1;   // oT1
    float4 texcoord2   : TEXCOORD2;   // oT2
    float4 texcoord3   : TEXCOORD3;   // oT3
};

float4 xv_dph(float4 a, float4 b) { return float4(dot(a.xyz, b.xyz) + b.w); }

float4 xv_rsq(float4 s) { return float4(rsqrt(abs(s.x))); }

// D3DVSDT_NORMPACKED3: 11:11:10 signed-normalised packed into one DWORD.
// Attribute is bound as U8 x4 (raw, not normalised) so b = bytes 0..3 as floats.
float3 xv_unpack_normpacked3(float4 b)
{
    float x = b.x + fmod(b.y, 8.0) * 256.0;                    // bits  0..10
    float y = floor(b.y / 8.0) + fmod(b.z, 64.0) * 32.0;       // bits 11..21
    float z = floor(b.z / 64.0) + b.w * 4.0;                   // bits 22..31
    x = (x >= 1024.0) ? x - 2048.0 : x;
    y = (y >= 1024.0) ? y - 2048.0 : y;
    z = (z >=  512.0) ? z - 1024.0 : z;
    return float3(x / 1023.0, y / 1023.0, z / 511.0);
}

VertOut main(AppIn IN, uniform float4 c[192])
{
    VertOut OUT;
    // --- attribute loads (expanded to float4 exactly as the NV2A input file presents them)
    float4 v0 = float4(IN.position, 1.0);
    float4 v1 = float4(xv_unpack_normpacked3(IN.blendweight), 1.0);   // bind as U8 x4 (raw bytes); unpacked in-shader
    float4 v2 = float4(xv_unpack_normpacked3(IN.normal), 1.0);   // bind as U8 x4 (raw bytes); unpacked in-shader
    float4 v3 = float4(xv_unpack_normpacked3(IN.color0), 1.0);   // bind as U8 x4 (raw bytes); unpacked in-shader
    float4 v4 = float4(IN.color1, 0.0, 1.0);   // S16N
    float4 v5 = float4(IN.fog, 0.0, 1.0);   // U8N
    float4 v6 = float4(IN.psize, 0.0, 0.0, 1.0);   // S16N

    // --- register file
    float4 r0 = float4(0.0, 0.0, 0.0, 0.0), r1 = float4(0.0, 0.0, 0.0, 0.0), r2 = float4(0.0, 0.0, 0.0, 0.0), r3 = float4(0.0, 0.0, 0.0, 0.0), r4 = float4(0.0, 0.0, 0.0, 0.0), r5 = float4(0.0, 0.0, 0.0, 0.0), r6 = float4(0.0, 0.0, 0.0, 0.0), r7 = float4(0.0, 0.0, 0.0, 0.0), r8 = float4(0.0, 0.0, 0.0, 0.0), r9 = float4(0.0, 0.0, 0.0, 0.0), r10 = float4(0.0, 0.0, 0.0, 0.0), r11 = float4(0.0, 0.0, 0.0, 0.0);
    float4 oPos = float4(0.0, 0.0, 0.0, 1.0), oD0 = float4(0.0, 0.0, 0.0, 0.0), oT0 = float4(0.0, 0.0, 0.0, 0.0), oT1 = float4(0.0, 0.0, 0.0, 0.0), oT2 = float4(0.0, 0.0, 0.0, 0.0), oT3 = float4(0.0, 0.0, 0.0, 0.0);
    int a0 = 0;

    // --- program (one NV2A slot per block; MAC and ILU read before either writes)
    // [00] mul r2.xy, v5, c[7].w
    {
        float4 m = v5 * c[7].wwww;
        r2.xy = m.xy;
    }
    // [01] arl a0.x, r2.x
    {
        a0 = (int)floor((r2.xxxx).x);
    }
    // [02] mul r3, v6.x, c[a0.x+60]
    {
        float4 m = v6.xxxx * c[(a0 + 60) < 0 ? 0 : ((a0 + 60) > 191 ? 191 : (a0 + 60))];
        r3 = m;
    }
    // [03] mul r4, v6.x, c[a0.x+61]
    {
        float4 m = v6.xxxx * c[(a0 + 61) < 0 ? 0 : ((a0 + 61) > 191 ? 191 : (a0 + 61))];
        r4 = m;
    }
    // [04] mul r5, v6.x, c[a0.x+62]
    {
        float4 m = v6.xxxx * c[(a0 + 62) < 0 ? 0 : ((a0 + 62) > 191 ? 191 : (a0 + 62))];
        r5 = m;
    }
    // [05] arl a0.x, r2.y
    {
        a0 = (int)floor((r2.yyyy).x);
    }
    // [06] add r6.x, v6.w, -v6.x
    {
        float4 m = v6.wwww + -v6.xxxx;
        r6.x = m.x;
    }
    // [07] mul oT0.xy, v4, c[12].xyyy
    {
        float4 m = v4 * c[12].xyyy;
        oT0.xy = m.xy;
    }
    // [08] mad r7, r6.x, c[a0.x+60], r3
    {
        float4 m = r6.xxxx * c[(a0 + 60) < 0 ? 0 : ((a0 + 60) > 191 ? 191 : (a0 + 60))] + r3;
        r7 = m;
    }
    // [09] mad r8, r6.x, c[a0.x+61], r4
    {
        float4 m = r6.xxxx * c[(a0 + 61) < 0 ? 0 : ((a0 + 61) > 191 ? 191 : (a0 + 61))] + r4;
        r8 = m;
    }
    // [10] mad r9, r6.x, c[a0.x+62], r5
    {
        float4 m = r6.xxxx * c[(a0 + 62) < 0 ? 0 : ((a0 + 62) > 191 ? 191 : (a0 + 62))] + r5;
        r9 = m;
    }
    // [11] dph r10.x, v0, r7
    {
        float4 m = xv_dph(v0, r7);
        r10.x = m.x;
    }
    // [12] dph r10.y, v0, r8
    {
        float4 m = xv_dph(v0, r8);
        r10.y = m.y;
    }
    // [13] dph r10.z, v0, r9
    {
        float4 m = xv_dph(v0, r9);
        r10.z = m.z;
    }
    // [14] dp3 r11.x, v1, r7
    {
        float4 m = float4(dot((v1).xyz, (r7).xyz));
        r11.x = m.x;
    }
    // [15] dp3 r11.y, v1, r8
    {
        float4 m = float4(dot((v1).xyz, (r8).xyz));
        r11.y = m.y;
    }
    // [16] dp3 r11.z, v1, r9
    {
        float4 m = float4(dot((v1).xyz, (r9).xyz));
        r11.z = m.z;
    }
    // [17] dp3 r3.x, v2, r7
    {
        float4 m = float4(dot((v2).xyz, (r7).xyz));
        r3.x = m.x;
    }
    // [18] dp3 r0.w, r11, r11
    {
        float4 m = float4(dot((r11).xyz, (r11).xyz));
        r0.w = m.w;
    }
    // [19] dp3 r3.z, v2, r9
    {
        float4 m = float4(dot((v2).xyz, (r9).xyz));
        r3.z = m.z;
    }
    // [20] dp3 r3.y, v2, r8 | rsq r1.w, r0.w
    {
        float4 m = float4(dot((v2).xyz, (r8).xyz));
        float4 i = xv_rsq(r0.wwww);
        r3.y = m.y;
        r1.w = i.w;
    }
    // [21] dp3 r6.x, v3, r7
    {
        float4 m = float4(dot((v3).xyz, (r7).xyz));
        r6.x = m.x;
    }
    // [22] mul r2.xyz, r11, r1.w
    {
        float4 m = r11 * r1.wwww;
        r2.xyz = m.xyz;
    }
    // [23] dp3 r4.w, r3, r3 | mov oT1.z, r2.x
    {
        float4 m = float4(dot((r3).xyz, (r3).xyz));
        float4 i = r2.xxxx;
        r4.w = m.w;
        oT1.z = i.z;
    }
    // [24] dp3 r6.z, v3, r9 | mov oT3.z, r2
    {
        float4 m = float4(dot((v3).xyz, (r9).xyz));
        float4 i = r2;
        r6.z = m.z;
        oT3.z = i.z;
    }
    // [25] dp3 r6.y, v3, r8 | rsq r1.w, r4.w
    {
        float4 m = float4(dot((v3).xyz, (r8).xyz));
        float4 i = xv_rsq(r4.wwww);
        r6.y = m.y;
        r1.w = i.w;
    }
    // [26] add r9.xyz, -r10, c[4]
    {
        float4 m = -r10 + c[4];
        r9.xyz = m.xyz;
    }
    // [27] mul r5.xyz, r3, r1.w | mov oT2.z, r2.y
    {
        float4 m = r3 * r1.wwww;
        float4 i = r2.yyyy;
        r5.xyz = m.xyz;
        oT2.z = i.z;
    }
    // [28] dp3 r7.w, r6, r6 | mov oT1.y, r5.x
    {
        float4 m = float4(dot((r6).xyz, (r6).xyz));
        float4 i = r5.xxxx;
        r7.w = m.w;
        oT1.y = i.y;
    }
    // [29] dph oPos.y, r10, c[1]
    {
        float4 m = xv_dph(r10, c[1]);
        oPos.y = m.y;
    }
    // [30] dph oPos.x, r10, c[0] | rsq r1.w, r7.w
    {
        float4 m = xv_dph(r10, c[0]);
        float4 i = xv_rsq(r7.wwww);
        oPos.x = m.x;
        r1.w = i.w;
    }
    // [31] dph oPos.z, r10, c[2]
    {
        float4 m = xv_dph(r10, c[2]);
        oPos.z = m.z;
    }
    // [32] mul r8.xyz, r6, r1.w | mov oT2.y, r5
    {
        float4 m = r6 * r1.wwww;
        float4 i = r5;
        r8.xyz = m.xyz;
        oT2.y = i.y;
    }
    // [33] dph oPos.w, r10, c[3]
    {
        float4 m = xv_dph(r10, c[3]);
        oPos.w = m.w;
    }
    // [34] dph r11.x, r10, c[9] | mov oT1.x, r8
    {
        float4 m = xv_dph(r10, c[9]);
        float4 i = r8;
        r11.x = m.x;
        oT1.x = i.x;
    }
    // [35] dph r11.y, r10, c[10] | mov oT2.x, r8.y
    {
        float4 m = xv_dph(r10, c[10]);
        float4 i = r8.yyyy;
        r11.y = m.y;
        oT2.x = i.x;
    }
    // [36] dph r0.z, r10, c[8] | mov oT3.x, r8.z
    {
        float4 m = xv_dph(r10, c[8]);
        float4 i = r8.zzzz;
        r0.z = m.z;
        oT3.x = i.x;
    }
    // [37] mov oT3.y, r5.z
    {
        float4 m = r5.zzzz;
        oT3.y = m.y;
    }
    // [38] mov oT1.w, r9.x
    {
        float4 m = r9.xxxx;
        oT1.w = m.w;
    }
    // [39] mov oT2.w, r9.y
    {
        float4 m = r9.yyyy;
        oT2.w = m.w;
    }
    // [40] mov oT3.w, r9.z
    {
        float4 m = r9.zzzz;
        oT3.w = m.w;
    }
    // [41] add r0.xy, v4.w, -r11
    {
        float4 m = v4.wwww + -r11;
        r0.xy = m.xy;
    }
    // [42] mul oPos.xyz, r12, c[58] | rcc r1.x, r12.w    <- stripped: Xbox viewport epilogue (GXM divides by w)
    // [43] max r2.xyz, r0, v4.z
    {
        float4 m = max(r0, v4.zzzz);
        r2.xyz = m.xyz;
    }
    // [44] mul r2.xy, r2, r2
    {
        float4 m = r2 * r2;
        r2.xy = m.xy;
    }
    // [45] min r3.xyz, r2, v4.w
    {
        float4 m = min(r2, v4.wwww);
        r3.xyz = m.xyz;
    }
    // [46] add r4.x, r3.x, r3.y
    {
        float4 m = r3.xxxx + r3.yyyy;
        r4.x = m.x;
    }
    // [47] mul r8.z, r3.z, c[11].x
    {
        float4 m = r3.zzzz * c[11].xxxx;
        r8.z = m.z;
    }
    // [48] min r3.x, r4, v4.w
    {
        float4 m = min(r4, v4.wwww);
        r3.x = m.x;
    }
    // [49] add r4.xy, v4.w, -r3
    {
        float4 m = v4.wwww + -r3;
        r4.xy = m.xy;
    }
    // [50] mad oPos.xyz, r12, r1.x, c[59]    <- stripped: Xbox viewport epilogue (GXM divides by w)
    // [51] mul r5.xy, r4, r4
    {
        float4 m = r4 * r4;
        r5.xy = m.xy;
    }
    // [52] add r6.y, r5.y, -r5.x
    {
        float4 m = r5.yyyy + -r5.xxxx;
        r6.y = m.y;
    }
    // [53] mad r7.w, c[11].y, r6.y, r5.x
    {
        float4 m = c[11].yyyy * r6.yyyy + r5.xxxx;
        r7.w = m.w;
    }
    // [54] mul r8.w, r7.w, c[11].z
    {
        float4 m = r7.wwww * c[11].zzzz;
        r8.w = m.w;
    }
    // [55] add r9.zw, -r8, v4.w
    {
        float4 m = -r8 + v4.wwww;
        r9.zw = m.zw;
    }
    // [56] mul oD0.w, r9.z, r9.w
    {
        float4 m = r9.zzzz * r9.wwww;
        oD0.w = m.w;
    }

    // --- outputs
    OUT.position = float4(oPos.xy, oPos.z * 0.9999, oPos.w);   /* keep z < w: Halo puts the sky exactly on the far plane and GXM clips z == w away */
    OUT.color0 = oD0;
    OUT.texcoord0 = oT0;
    OUT.texcoord1 = oT1;
    OUT.texcoord2 = oT2;
    OUT.texcoord3 = oT3;
    return OUT;
}

