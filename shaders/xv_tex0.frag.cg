// Xita runtime fragment shader: texture stage 0 only (debug / fallback when the vertex
// program writes no diffuse colour).
struct VertOut
{
    float4 position  : POSITION;
    float4 texcoord0 : TEXCOORD0;
};

float4 main(VertOut IN, uniform sampler2D tex0) : COLOR
{
    return tex2D(tex0, IN.texcoord0.xy);
}
