        half  a_A = saturate(half4(0.0, 0.0, 0.0, 0.0).b), a_B = saturate(half4(0.0, 0.0, 0.0, 0.0).b), a_C = saturate(half4(0.0, 0.0, 0.0, 0.0).b), a_D = saturate(half4(0.0, 0.0, 0.0, 0.0).b);
