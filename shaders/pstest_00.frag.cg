// ---------------------------------------------------------------------------
//  Xita Stage 3b - auto-generated Vita Cg fragment shader: pstest_00
//  source def: VA None  file 0x0
//  1 combiner stage(s); textures t0:PROJECT2D
//  Uniforms: psc[16] = SetPixelShaderConstant regs; xv_fogcolor.rgb; fog factor = TEXCOORD7
//    stage 0 rgb  : r0 = sum(t0.rgb * v0.rgb, zero.rgb * zero.rgb)
//    stage 0 alpha: r0 = sum(t0.a * v0.a, zero.b * zero.b)
//    final      : (default) out = lerp(fog.rgb, r0.rgb, fog.a), r0.a
// ---------------------------------------------------------------------------

struct VertOut
{
    float4 position    : POSITION;
    float4 color0      : COLOR0;
    float4 color1      : COLOR1;
    float4 texcoord0   : TEXCOORD0;
    float  fog         : TEXCOORD7;
};

float4 main(VertOut IN, uniform sampler2D tex0, uniform float4 psc[16], uniform float4 xv_fogcolor) : COLOR
{
    // ---- inputs
    float4 v0 = IN.color0, v1 = IN.color1;
    float4 fog = float4(xv_fogcolor.rgb, IN.fog);
    float4 r0 = float4(0.0, 0.0, 0.0, 0.0), r1 = float4(0.0, 0.0, 0.0, 0.0);
    float4 t0 = tex2D(tex0, IN.texcoord0.xy);
    float4 t1 = float4(0.0, 0.0, 0.0, 0.0);
    float4 t2 = float4(0.0, 0.0, 0.0, 0.0);
    float4 t3 = float4(0.0, 0.0, 0.0, 0.0);
    // ---- combiner stage 0
    {
        float3 A = saturate(t0.rgb), B = saturate(v0.rgb), C = saturate(float4(0.0, 0.0, 0.0, 0.0).rgb), D = saturate(float4(0.0, 0.0, 0.0, 0.0).rgb);
        float3 AB = A * B;
        float3 CD = C * D;
        float3 SUM = AB + CD;
        float  a_A = saturate(t0.a), a_B = saturate(v0.a), a_C = saturate(float4(0.0, 0.0, 0.0, 0.0).b), a_D = saturate(float4(0.0, 0.0, 0.0, 0.0).b);
        float  a_AB = a_A * a_B, a_CD = a_C * a_D;
        float  a_SUM = a_AB + a_CD;
        r0.rgb = clamp(SUM, -1.0, 1.0);
        r0.a = clamp(a_SUM, -1.0, 1.0);
    }
    // ---- final combiner
    // (no final combiner in the def: Xbox D3D default = fixed-function fog blend)
    float3 out_rgb = lerp(fog.rgb, r0.rgb, fog.a);
    float  out_a   = r0.a;
    return saturate(float4(out_rgb, out_a));
}
