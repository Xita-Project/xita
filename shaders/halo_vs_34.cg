// ---------------------------------------------------------------------------
//  Xita Stage 3 - auto-generated Vita Cg vertex shader
//  source : halo_vs_34.json
//  mode   : NV2A microcode translation
//  target : psp2cgc -profile sce_vp_psp2
//
//  Uniform contract:
//    uniform float4 c[23]  - universal constant array, C_BASE = -96
//    runtime maps SetVertexShaderConstant(reg, v) -> c[reg - C_BASE]
//    microcode uses D3D c-96..c-74 (hardware c[0]..)
//    43 of 45 NV2A slots translated; inputs v0 v1 v4; outputs oPos oD0 oD1 oT0 oT1 oT2 oT3
//    slots [37, 40] = Xbox viewport epilogue, stripped (pass --keep-viewport-epilogue to translate verbatim)
//  Attribute binding (sceGxmVertexAttribute regIndex from parameter name):
//    v0  position    float3 FLOAT3      stream 0 +0 (12 B)
//    v1  blendweight float4 NORMPACKED3 stream 0 +12 (4 B)  // bind as U8 x4 (raw bytes); unpacked in-shader
//    v2  normal      float4 NORMPACKED3 stream 0 +16 (4 B)  // bind as U8 x4 (raw bytes); unpacked in-shader
//    v3  color0      float4 NORMPACKED3 stream 0 +20 (4 B)  // bind as U8 x4 (raw bytes); unpacked in-shader
//    v4  color1      float2 FLOAT2      stream 0 +24 (8 B)
//  Depth: D3D clip z in [0, w] is passed through unchanged; set the GXM viewport
//         with zOffset = 0, zScale = 1 (no [-1,1] -> [0,1] remap) to match.
// ---------------------------------------------------------------------------

struct AppIn
{
    float3 position    : POSITION;   // v0 FLOAT3
    float4 blendweight : BLENDWEIGHT;   // v1 NORMPACKED3
    float4 normal      : NORMAL;   // v2 NORMPACKED3
    float4 color0      : COLOR0;   // v3 NORMPACKED3
    float2 color1      : COLOR1;   // v4 FLOAT2
};

struct VertOut
{
    float4 position    : POSITION;   // oPos
    float4 color0      : COLOR0;   // oD0
    float4 color1      : COLOR1;   // oD1
    float4 texcoord0   : TEXCOORD0;   // oT0
    float4 texcoord1   : TEXCOORD1;   // oT1
    float4 texcoord2   : TEXCOORD2;   // oT2
    float4 texcoord3   : TEXCOORD3;   // oT3
};

float4 xv_dph(float4 a, float4 b) { return float4(dot(a.xyz, b.xyz) + b.w); }

// D3DVSDT_NORMPACKED3: 11:11:10 signed-normalised packed into one DWORD.
// Attribute is bound as U8 x4 (raw, not normalised) so b = bytes 0..3 as floats.
float3 xv_unpack_normpacked3(float4 b)
{
    float x = b.x + fmod(b.y, 8.0) * 256.0;                    // bits  0..10
    float y = floor(b.y / 8.0) + fmod(b.z, 64.0) * 32.0;       // bits 11..21
    float z = floor(b.z / 64.0) + b.w * 4.0;                   // bits 22..31
    x = (x >= 1024.0) ? x - 2048.0 : x;
    y = (y >= 1024.0) ? y - 2048.0 : y;
    z = (z >=  512.0) ? z - 1024.0 : z;
    return float3(x / 1023.0, y / 1023.0, z / 511.0);
}

VertOut main(AppIn IN, uniform float4 c[23])
{
    VertOut OUT;
    // --- attribute loads (expanded to float4 exactly as the NV2A input file presents them)
    float4 v0 = float4(IN.position, 1.0);
    float4 v1 = float4(xv_unpack_normpacked3(IN.blendweight), 1.0);   // bind as U8 x4 (raw bytes); unpacked in-shader
    float4 v4 = float4(IN.color1, 0.0, 1.0);

    // --- register file
    float4 r5 = float4(0.0, 0.0, 0.0, 0.0), r6 = float4(0.0, 0.0, 0.0, 0.0), r8 = float4(0.0, 0.0, 0.0, 0.0), r10 = float4(0.0, 0.0, 0.0, 0.0), r11 = float4(0.0, 0.0, 0.0, 0.0);
    float4 oPos = float4(0.0, 0.0, 0.0, 1.0), oD0 = float4(0.0, 0.0, 0.0, 0.0), oD1 = float4(0.0, 0.0, 0.0, 0.0), oT0 = float4(0.0, 0.0, 0.0, 0.0), oT1 = float4(0.0, 0.0, 0.0, 0.0), oT2 = float4(0.0, 0.0, 0.0, 0.0), oT3 = float4(0.0, 0.0, 0.0, 0.0);

    // --- program (one NV2A slot per block; MAC and ILU read before either writes)
    // [00] add r5.xyz, -v0, c[4]
    {
        float4 m = -v0 + c[4];
        r5.xyz = m.xyz;
    }
    // [01] dph oPos.x, v0, c[0]
    {
        float4 m = xv_dph(v0, c[0]);
        oPos.x = m.x;
    }
    // [02] dp3 r6.x, r5, v1
    {
        float4 m = float4(dot((r5).xyz, (v1).xyz));
        r6.x = m.x;
    }
    // [03] dph oPos.y, v0, c[1]
    {
        float4 m = xv_dph(v0, c[1]);
        oPos.y = m.y;
    }
    // [04] mul r6.xyz, r6.x, v1
    {
        float4 m = r6.xxxx * v1;
        r6.xyz = m.xyz;
    }
    // [05] mad r6.xyz, r6.xyzz, c[4].w, -r5
    {
        float4 m = r6.xyzz * c[4].wwww + -r5;
        r6.xyz = m.xyz;
    }
    // [06] dph oPos.z, v0, c[2]
    {
        float4 m = xv_dph(v0, c[2]);
        oPos.z = m.z;
    }
    // [07] dph oPos.w, v0, c[3]
    {
        float4 m = xv_dph(v0, c[3]);
        oPos.w = m.w;
    }
    // [08] mov r11.xyz, c[16]
    {
        float4 m = c[16];
        r11.xyz = m.xyz;
    }
    // [09] mul r10.xyz, c[15].yzxw, r11.zxyw
    {
        float4 m = c[15].yzxw * r11.zxyw;
        r10.xyz = m.xyz;
    }
    // [10] mad r10.xyz, -r11.yzxw, c[15].zxyw, r10
    {
        float4 m = -r11.yzxw * c[15].zxyw + r10;
        r10.xyz = m.xyz;
    }
    // [11] dp3 oT0.x, r6, c[15]
    {
        float4 m = float4(dot((r6).xyz, (c[15]).xyz));
        oT0.x = m.x;
    }
    // [12] dp3 oT0.y, r6, c[16]
    {
        float4 m = float4(dot((r6).xyz, (c[16]).xyz));
        oT0.y = m.y;
    }
    // [13] dp3 oT0.z, r6, r10
    {
        float4 m = float4(dot((r6).xyz, (r10).xyz));
        oT0.z = m.z;
    }
    // [14] dph oT1.x, v4, c[17]
    {
        float4 m = xv_dph(v4, c[17]);
        oT1.x = m.x;
    }
    // [15] dph oT1.y, v4, c[18]
    {
        float4 m = xv_dph(v4, c[18]);
        oT1.y = m.y;
    }
    // [16] dph oT2.x, v4, c[19]
    {
        float4 m = xv_dph(v4, c[19]);
        oT2.x = m.x;
    }
    // [17] dph oT2.y, v4, c[20]
    {
        float4 m = xv_dph(v4, c[20]);
        oT2.y = m.y;
    }
    // [18] dph oT3.x, v4, c[21]
    {
        float4 m = xv_dph(v4, c[21]);
        oT3.x = m.x;
    }
    // [19] dph oT3.y, v4, c[22]
    {
        float4 m = xv_dph(v4, c[22]);
        oT3.y = m.y;
    }
    // [20] dph r8.x, v0, c[9]
    {
        float4 m = xv_dph(v0, c[9]);
        r8.x = m.x;
    }
    // [21] dph r8.y, v0, c[10]
    {
        float4 m = xv_dph(v0, c[10]);
        r8.y = m.y;
    }
    // [22] dph r8.z, v0, c[8]
    {
        float4 m = xv_dph(v0, c[8]);
        r8.z = m.z;
    }
    // [23] add r8.xy, v4.w, -r8
    {
        float4 m = v4.wwww + -r8;
        r8.xy = m.xy;
    }
    // [24] dp3 r10.x, v1, -c[5]
    {
        float4 m = float4(dot((v1).xyz, (-c[5]).xyz));
        r10.x = m.x;
    }
    // [25] max r8.xyz, r8, v4.z
    {
        float4 m = max(r8, v4.zzzz);
        r8.xyz = m.xyz;
    }
    // [26] mul r8.xy, r8, r8
    {
        float4 m = r8 * r8;
        r8.xy = m.xy;
    }
    // [27] min r8.xyz, r8, v4.w
    {
        float4 m = min(r8, v4.wwww);
        r8.xyz = m.xyz;
    }
    // [28] add r8.x, r8.x, r8.y
    {
        float4 m = r8.xxxx + r8.yyyy;
        r8.x = m.x;
    }
    // [29] mul r8.z, r8.z, c[11].x
    {
        float4 m = r8.zzzz * c[11].xxxx;
        r8.z = m.z;
    }
    // [30] min r8.x, r8, v4.w
    {
        float4 m = min(r8, v4.wwww);
        r8.x = m.x;
    }
    // [31] add r8.xy, v4.w, -r8
    {
        float4 m = v4.wwww + -r8;
        r8.xy = m.xy;
    }
    // [32] max r10.x, r10.x, -r10.x
    {
        float4 m = max(r10.xxxx, -r10.xxxx);
        r10.x = m.x;
    }
    // [33] mul r8.xy, r8, r8
    {
        float4 m = r8 * r8;
        r8.xy = m.xy;
    }
    // [34] add r8.y, r8.y, -r8.x
    {
        float4 m = r8.yyyy + -r8.xxxx;
        r8.y = m.y;
    }
    // [35] add r10.y, v4.w, -r10.x
    {
        float4 m = v4.wwww + -r10.xxxx;
        r10.y = m.y;
    }
    // [36] mad r8.w, c[11].y, r8.y, r8.x
    {
        float4 m = c[11].yyyy * r8.yyyy + r8.xxxx;
        r8.w = m.w;
    }
    // [37] mul oPos.xyz, r12, c[58] | rcc r1.x, r12.w    <- stripped: Xbox viewport epilogue (GXM divides by w)
    // [38] mul r8.w, r8.w, c[11].z
    {
        float4 m = r8.wwww * c[11].zzzz;
        r8.w = m.w;
    }
    // [39] add r8.zw, -r8, v4.w
    {
        float4 m = -r8 + v4.wwww;
        r8.zw = m.zw;
    }
    // [40] mad oPos.xyz, r12, r1.x, c[59]    <- stripped: Xbox viewport epilogue (GXM divides by w)
    // [41] mul r8.w, r8.z, r8.w
    {
        float4 m = r8.zzzz * r8.wwww;
        r8.w = m.w;
    }
    // [42] mul r10.xy, r10, r8.w
    {
        float4 m = r10 * r8.wwww;
        r10.xy = m.xy;
    }
    // [43] mul oD0.w, r8.w, c[14].z
    {
        float4 m = r8.wwww * c[14].zzzz;
        oD0.w = m.w;
    }
    // [44] mul oD1, r10.xxxy, c[14].z
    {
        float4 m = r10.xxxy * c[14].zzzz;
        oD1 = m;
    }

    // --- outputs
    OUT.position = float4(oPos.xy, oPos.z * 0.9999, oPos.w);   /* keep z < w: Halo puts the sky exactly on the far plane and GXM clips z == w away */
    OUT.color0 = oD0;
    OUT.color1 = oD1;
    OUT.texcoord0 = oT0;
    OUT.texcoord1 = oT1;
    OUT.texcoord2 = oT2;
    OUT.texcoord3 = oT3;
    return OUT;
}

