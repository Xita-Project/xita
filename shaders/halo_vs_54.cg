// ---------------------------------------------------------------------------
//  Xita Stage 3 - auto-generated Vita Cg vertex shader
//  source : halo_vs_54.json
//  mode   : NV2A microcode translation
//  target : psp2cgc -profile sce_vp_psp2
//
//  Uniform contract:
//    uniform float4 c[8]  - universal constant array, C_BASE = -96
//    runtime maps SetVertexShaderConstant(reg, v) -> c[reg - C_BASE]
//    microcode uses D3D c-96..c-89 (hardware c[0]..)
//    33 of 35 NV2A slots translated; inputs v0 v1 v2 v3 v7; outputs oPos oD0 oD1 oFog oT0 oT1 oT2 oT3
//    slots [33, 34] = Xbox viewport epilogue, stripped (pass --keep-viewport-epilogue to translate verbatim)
//  Attribute binding (sceGxmVertexAttribute regIndex from parameter name):
//    v0  position    float3 FLOAT3      stream 0 +0 (12 B)
//    v1  blendweight float4 NORMPACKED3 stream 0 +12 (4 B)  // bind as U8 x4 (raw bytes); unpacked in-shader
//    v2  normal      float4 NORMPACKED3 stream 0 +16 (4 B)  // bind as U8 x4 (raw bytes); unpacked in-shader
//    v3  color0      float4 NORMPACKED3 stream 0 +20 (4 B)  // bind as U8 x4 (raw bytes); unpacked in-shader
//    v4  color1      float2 FLOAT2      stream 0 +24 (8 B)
//    v7  backcolor0  float4 FLOAT4      not in declaration
//  Depth: D3D clip z in [0, w] is passed through unchanged; set the GXM viewport
//         with zOffset = 0, zScale = 1 (no [-1,1] -> [0,1] remap) to match.
// ---------------------------------------------------------------------------

struct AppIn
{
    float3 position    : POSITION;   // v0 FLOAT3
    float4 blendweight : BLENDWEIGHT;   // v1 NORMPACKED3
    float4 normal      : NORMAL;   // v2 NORMPACKED3
    float4 color0      : COLOR0;   // v3 NORMPACKED3
    float2 color1      : COLOR1;   // v4 FLOAT2
    float4 backcolor0  : TEXCOORD6;   // v7 FLOAT4
};

struct VertOut
{
    float4 position    : POSITION;   // oPos
    float4 color0      : COLOR0;   // oD0
    float4 color1      : COLOR1;   // oD1
    float  fog         : TEXCOORD7;   // oFog
    float4 texcoord0   : TEXCOORD0;   // oT0
    float4 texcoord1   : TEXCOORD1;   // oT1
    float4 texcoord2   : TEXCOORD2;   // oT2
    float4 texcoord3   : TEXCOORD3;   // oT3
};

float4 xv_dph(float4 a, float4 b) { return float4(dot(a.xyz, b.xyz) + b.w); }

float4 xv_rsq(float4 s) { return float4(rsqrt(abs(s.x))); }

// D3DVSDT_NORMPACKED3: 11:11:10 signed-normalised packed into one DWORD.
// Attribute is bound as U8 x4 (raw, not normalised) so b = bytes 0..3 as floats.
float3 xv_unpack_normpacked3(float4 b)
{
    float x = b.x + fmod(b.y, 8.0) * 256.0;                    // bits  0..10
    float y = floor(b.y / 8.0) + fmod(b.z, 64.0) * 32.0;       // bits 11..21
    float z = floor(b.z / 64.0) + b.w * 4.0;                   // bits 22..31
    x = (x >= 1024.0) ? x - 2048.0 : x;
    y = (y >= 1024.0) ? y - 2048.0 : y;
    z = (z >=  512.0) ? z - 1024.0 : z;
    return float3(x / 1023.0, y / 1023.0, z / 511.0);
}

VertOut main(AppIn IN, uniform float4 c[8])
{
    VertOut OUT;
    // --- attribute loads (expanded to float4 exactly as the NV2A input file presents them)
    float4 v0 = float4(IN.position, 1.0);
    float4 v1 = float4(xv_unpack_normpacked3(IN.blendweight), 1.0);   // bind as U8 x4 (raw bytes); unpacked in-shader
    float4 v2 = float4(xv_unpack_normpacked3(IN.normal), 1.0);   // bind as U8 x4 (raw bytes); unpacked in-shader
    float4 v3 = float4(xv_unpack_normpacked3(IN.color0), 1.0);   // bind as U8 x4 (raw bytes); unpacked in-shader
    float4 v7 = IN.backcolor0;   // not in declaration

    // --- register file
    float4 r1 = float4(0.0, 0.0, 0.0, 0.0), r2 = float4(0.0, 0.0, 0.0, 0.0), r3 = float4(0.0, 0.0, 0.0, 0.0), r4 = float4(0.0, 0.0, 0.0, 0.0), r5 = float4(0.0, 0.0, 0.0, 0.0), r6 = float4(0.0, 0.0, 0.0, 0.0), r7 = float4(0.0, 0.0, 0.0, 0.0), r8 = float4(0.0, 0.0, 0.0, 0.0), r9 = float4(0.0, 0.0, 0.0, 0.0), r10 = float4(0.0, 0.0, 0.0, 0.0), r11 = float4(0.0, 0.0, 0.0, 0.0);
    float4 oPos = float4(0.0, 0.0, 0.0, 1.0), oD0 = float4(0.0, 0.0, 0.0, 0.0), oD1 = float4(0.0, 0.0, 0.0, 0.0), oFog = float4(0.0, 0.0, 0.0, 0.0), oT0 = float4(0.0, 0.0, 0.0, 0.0), oT1 = float4(0.0, 0.0, 0.0, 0.0), oT2 = float4(0.0, 0.0, 0.0, 0.0), oT3 = float4(0.0, 0.0, 0.0, 0.0);

    // --- program (one NV2A slot per block; MAC and ILU read before either writes)
    // [00] dph oPos.x, v0, c[0]
    {
        float4 m = xv_dph(v0, c[0]);
        oPos.x = m.x;
    }
    // [01] dph oPos.y, v0, c[1]
    {
        float4 m = xv_dph(v0, c[1]);
        oPos.y = m.y;
    }
    // [02] dph oPos.z, v0, c[2]
    {
        float4 m = xv_dph(v0, c[2]);
        oPos.z = m.z;
    }
    // [03] dph oPos.w, v0, c[3]
    {
        float4 m = xv_dph(v0, c[3]);
        oPos.w = m.w;
    }
    // [04] mov r2.xyz, v1
    {
        float4 m = v1;
        r2.xyz = m.xyz;
    }
    // [05] mov r3.xyz, v2
    {
        float4 m = v2;
        r3.xyz = m.xyz;
    }
    // [06] mov r4.xyz, v3
    {
        float4 m = v3;
        r4.xyz = m.xyz;
    }
    // [07] add r5.xyz, -v0, c[4]
    {
        float4 m = -v0 + c[4];
        r5.xyz = m.xyz;
    }
    // [08] mad oD1.xyz, v7, c[5].w, c[5].w
    {
        float4 m = v7 * c[5].wwww + c[5].wwww;
        oD1.xyz = m.xyz;
    }
    // [09] dp3 r6.w, r5, r5
    {
        float4 m = float4(dot((r5).xyz, (r5).xyz));
        r6.w = m.w;
    }
    // [10] dp3 r10.x, r2, r4
    {
        float4 m = float4(dot((r2).xyz, (r4).xyz));
        r10.x = m.x;
    }
    // [11] dp3 r9.x, r2, r3 | rsq r1.w, r6.w
    {
        float4 m = float4(dot((r2).xyz, (r3).xyz));
        float4 i = xv_rsq(r6.wwww);
        r9.x = m.x;
        r1.w = i.w;
    }
    // [12] mad oD1.w, r10.x, c[5].w, c[5].w
    {
        float4 m = r10.xxxx * c[5].wwww + c[5].wwww;
        oD1.w = m.w;
    }
    // [13] mul r7.xyz, r5, r1.w
    {
        float4 m = r5 * r1.wwww;
        r7.xyz = m.xyz;
    }
    // [14] dp3 r8.x, r7, r4
    {
        float4 m = float4(dot((r7).xyz, (r4).xyz));
        r8.x = m.x;
    }
    // [15] dp3 r8.y, r7, r3
    {
        float4 m = float4(dot((r7).xyz, (r3).xyz));
        r8.y = m.y;
    }
    // [16] dp3 r8.z, r7, r2
    {
        float4 m = float4(dot((r7).xyz, (r2).xyz));
        r8.z = m.z;
    }
    // [17] mad oD0.w, r9.x, c[5].w, c[5].w
    {
        float4 m = r9.xxxx * c[5].wwww + c[5].wwww;
        oD0.w = m.w;
    }
    // [18] mad oD0.xyz, r8, c[5].w, c[5].w
    {
        float4 m = r8 * c[5].wwww + c[5].wwww;
        oD0.xyz = m.xyz;
    }
    // [19] dp3 r11.x, r3, r4
    {
        float4 m = float4(dot((r3).xyz, (r4).xyz));
        r11.x = m.x;
    }
    // [20] dp3 oT0.x, r2, c[6]
    {
        float4 m = float4(dot((r2).xyz, (c[6]).xyz));
        oT0.x = m.x;
    }
    // [21] mad oFog.xw, r11.x, c[5].w, c[5].w
    {
        float4 m = r11.xxxx * c[5].wwww + c[5].wwww;
        oFog.xw = m.xw;
    }
    // [22] dp3 oT0.y, r2, c[7]
    {
        float4 m = float4(dot((r2).xyz, (c[7]).xyz));
        oT0.y = m.y;
    }
    // [23] dp3 oT0.z, r2, c[5]
    {
        float4 m = float4(dot((r2).xyz, (c[5]).xyz));
        oT0.z = m.z;
    }
    // [24] dp3 oT1.x, r3, c[6]
    {
        float4 m = float4(dot((r3).xyz, (c[6]).xyz));
        oT1.x = m.x;
    }
    // [25] dp3 oT1.y, r3, c[7]
    {
        float4 m = float4(dot((r3).xyz, (c[7]).xyz));
        oT1.y = m.y;
    }
    // [26] dp3 oT1.z, r3, c[5]
    {
        float4 m = float4(dot((r3).xyz, (c[5]).xyz));
        oT1.z = m.z;
    }
    // [27] dp3 oT2.x, r4, c[6]
    {
        float4 m = float4(dot((r4).xyz, (c[6]).xyz));
        oT2.x = m.x;
    }
    // [28] dp3 oT2.y, r4, c[7]
    {
        float4 m = float4(dot((r4).xyz, (c[7]).xyz));
        oT2.y = m.y;
    }
    // [29] dp3 oT2.z, r4, c[5]
    {
        float4 m = float4(dot((r4).xyz, (c[5]).xyz));
        oT2.z = m.z;
    }
    // [30] dp3 oT3.x, v7, c[6]
    {
        float4 m = float4(dot((v7).xyz, (c[6]).xyz));
        oT3.x = m.x;
    }
    // [31] dp3 oT3.y, v7, c[7]
    {
        float4 m = float4(dot((v7).xyz, (c[7]).xyz));
        oT3.y = m.y;
    }
    // [32] dp3 oT3.z, v7, c[5]
    {
        float4 m = float4(dot((v7).xyz, (c[5]).xyz));
        oT3.z = m.z;
    }
    // [33] mul oPos.xyz, r12, c[58] | rcc r1.x, r12.w    <- stripped: Xbox viewport epilogue (GXM divides by w)
    // [34] mad oPos.xyz, r12, r1.x, c[59]    <- stripped: Xbox viewport epilogue (GXM divides by w)

    // --- outputs
    OUT.position = float4(oPos.xy, oPos.z * 0.9999, oPos.w);   /* keep z < w: Halo puts the sky exactly on the far plane and GXM clips z == w away */
    OUT.color0 = oD0;
    OUT.color1 = oD1;
    OUT.fog = oFog.x;
    OUT.texcoord0 = oT0;
    OUT.texcoord1 = oT1;
    OUT.texcoord2 = oT2;
    OUT.texcoord3 = oT3;
    return OUT;
}

