// ---------------------------------------------------------------------------
//  Xita Stage 3b - auto-generated Vita Cg fragment shader: pstest_01
//  source def: VA None  file 0xF0
//  2 combiner stage(s); textures t0:PROJECT2D t1:PROJECT2D
//  Uniforms: psc[16] = SetPixelShaderConstant regs; xv_fogcolor.rgb; fog factor = TEXCOORD7
//    stage 0 rgb  : r0 = sum(t0.rgb * t1.rgb, zero.rgb * zero.rgb)  [x2]
//    stage 0 alpha: r0 = sum(t0.a * zero.b<unsigned_invert>, zero.b * zero.b)
//    stage 1 rgb  : r0 = sum(r0.rgb * v0.rgb, zero.rgb * zero.rgb)
//    stage 1 alpha: r0 = sum(r0.a * zero.b<unsigned_invert>, zero.b * zero.b)
//    final rgb  : fog.aaa * r0.rgb + (1 - fog.aaa) * fog.rgb + ef_prod.rgb
//    final alpha: r0.a
//    final ef_prod = c0.rgb * v1.rgb
// ---------------------------------------------------------------------------

struct VertOut
{
    float4 position    : POSITION;
    float4 color0      : COLOR0;
    float4 color1      : COLOR1;
    float4 texcoord0   : TEXCOORD0;
    float4 texcoord1   : TEXCOORD1;
    float  fog         : TEXCOORD7;
};

float4 main(VertOut IN, uniform sampler2D tex0, uniform sampler2D tex1, uniform float4 psc[16], uniform float4 xv_fogcolor) : COLOR
{
    // ---- inputs
    float4 v0 = IN.color0, v1 = IN.color1;
    float4 fog = float4(xv_fogcolor.rgb, IN.fog);
    float4 r0 = float4(0.0, 0.0, 0.0, 0.0), r1 = float4(0.0, 0.0, 0.0, 0.0);
    float4 t0 = tex2D(tex0, IN.texcoord0.xy);
    float4 t1 = tex2D(tex1, IN.texcoord1.xy);
    float4 t2 = float4(0.0, 0.0, 0.0, 0.0);
    float4 t3 = float4(0.0, 0.0, 0.0, 0.0);
    // ---- combiner stage 0
    {
        float3 A = saturate(t0.rgb), B = saturate(t1.rgb), C = saturate(float4(0.0, 0.0, 0.0, 0.0).rgb), D = saturate(float4(0.0, 0.0, 0.0, 0.0).rgb);
        float3 AB = A * B;
        float3 CD = C * D;
        float3 SUM = AB + CD;
        float  a_A = saturate(t0.a), a_B = (1.0 - saturate(float4(0.0, 0.0, 0.0, 0.0).b)), a_C = saturate(float4(0.0, 0.0, 0.0, 0.0).b), a_D = saturate(float4(0.0, 0.0, 0.0, 0.0).b);
        float  a_AB = a_A * a_B, a_CD = a_C * a_D;
        float  a_SUM = a_AB + a_CD;
        r0.rgb = clamp((SUM * 2.0), -1.0, 1.0);
        r0.a = clamp(a_SUM, -1.0, 1.0);
    }
    // ---- combiner stage 1
    {
        float3 A = saturate(r0.rgb), B = saturate(v0.rgb), C = saturate(float4(0.0, 0.0, 0.0, 0.0).rgb), D = saturate(float4(0.0, 0.0, 0.0, 0.0).rgb);
        float3 AB = A * B;
        float3 CD = C * D;
        float3 SUM = AB + CD;
        float  a_A = saturate(r0.a), a_B = (1.0 - saturate(float4(0.0, 0.0, 0.0, 0.0).b)), a_C = saturate(float4(0.0, 0.0, 0.0, 0.0).b), a_D = saturate(float4(0.0, 0.0, 0.0, 0.0).b);
        float  a_AB = a_A * a_B, a_CD = a_C * a_D;
        float  a_SUM = a_AB + a_CD;
        r0.rgb = clamp(SUM, -1.0, 1.0);
        r0.a = clamp(a_SUM, -1.0, 1.0);
    }
    // ---- final combiner
    float4 v1r0_sum = float4(v1.rgb + r0.rgb, 0.0);
    float4 ef_prod = float4(saturate(psc[0].rgb) * saturate(v1.rgb), 0.0);
    float3 FA = saturate(fog.aaa), FB = saturate(r0.rgb), FC = saturate(fog.rgb), FD = saturate(ef_prod.rgb);
    float3 out_rgb = FA * FB + (1.0 - FA) * FC + FD;
    float  out_a   = saturate(r0.a);
    return saturate(float4(out_rgb, out_a));
}
