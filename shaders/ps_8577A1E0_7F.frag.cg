    float4 t0 = tex2D(tex0, IN.texcoord0.xy);
    float4 t1 = tex2D(tex1, IN.texcoord1.xy);
    float4 t2 = texCUBE(tex2, IN.texcoord2.xyz);
    float4 t3 = texCUBE(tex3, IN.texcoord3.xyz);
    // ---- combiner stage 0
    {
        float3 A = (2.0 * max(t0.rgb, 0.0) - 1.0), B = (2.0 * max(t2.rgb, 0.0) - 1.0), C = saturate(t1.rgb), D = saturate(psc[0].aaa);
        float3 AB = float3(dot(A, B));
        float3 CD = float3(dot(C, D));
        float3 SUM = AB + CD;
        float  a_A = (2.0 * max(t3.b, 0.0) - 1.0), a_B = (1.0 - saturate(float4(0.0, 0.0, 0.0, 0.0).b)), a_C = (2.0 * max(t3.b, 0.0) - 1.0), a_D = (1.0 - saturate(float4(0.0, 0.0, 0.0, 0.0).b));
        float  a_AB = a_A * a_B, a_CD = a_C * a_D;
        float  a_SUM = a_AB + a_CD;
        r0.rgb = clamp(AB, -1.0, 1.0);
        t1.rgb = clamp(CD, -1.0, 1.0);
        v0.a = clamp((a_SUM * 4.0), -1.0, 1.0);
    }
    // ---- combiner stage 1
    {
        float3 A = (2.0 * max(t0.rgb, 0.0) - 1.0), B = (r0.rgb), C = (max(t2.rgb, 0.0) - 0.5), D = (2.0 * max(float4(0.0, 0.0, 0.0, 0.0).rgb, 0.0) - 1.0);
        float3 AB = A * B;
        float3 CD = C * D;
        float3 SUM = AB + CD;
        float  a_A = (2.0 * max(t2.b, 0.0) - 1.0), a_B = (1.0 - saturate(float4(0.0, 0.0, 0.0, 0.0).b)), a_C = (2.0 * max(t2.b, 0.0) - 1.0), a_D = (1.0 - saturate(float4(0.0, 0.0, 0.0, 0.0).b));
        float  a_AB = a_A * a_B, a_CD = a_C * a_D;
        float  a_SUM = a_AB + a_CD;
        r1.rgb = clamp((SUM * 2.0), -1.0, 1.0);
        v1.a = clamp((a_SUM * 4.0), -1.0, 1.0);
    }
    // ---- final combiner
    float4 v1r0_sum = float4(v1.rgb + r0.rgb, 0.0);
    float4 ef_prod = float4(saturate(float4(0.0, 0.0, 0.0, 0.0).rgb) * saturate(float4(0.0, 0.0, 0.0, 0.0).rgb), 0.0);
    float3 FA = saturate(float4(0.0, 0.0, 0.0, 0.0).rgb), FB = saturate(float4(0.0, 0.0, 0.0, 0.0).rgb), FC = saturate(float4(0.0, 0.0, 0.0, 0.0).rgb), FD = saturate(r0.rgb);
    float3 out_rgb = FA * FB + (1.0 - FA) * FC + FD;
    float  out_a   = saturate(r0.a);
    return saturate(float4(out_rgb, out_a));
}
