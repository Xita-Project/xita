//  Uniforms: psc[16] = SetPixelShaderConstant regs; xv_fogcolor.rgb; fog factor = TEXCOORD7
//    stage 0 rgb  : r0 = dot(t0.rgb<expand_normal>, t2.rgb<expand_normal>); t1 = dot(t1.rgb, c0.aaa)
//    stage 0 alpha: v0 = sum(t3.b<expand_normal> * zero.b<unsigned_invert>, t3.b<expand_normal> * zero.b<unsigned_invert>)  [x4]
//    stage 1 rgb  : r1 = sum(t0.rgb<expand_normal> * r0.rgb<signed_identity>, t2.rgb<halfbias_normal> * zero.rgb<expand_normal>)  [x2]
//    stage 1 alpha: v1 = sum(t2.b<expand_normal> * zero.b<unsigned_invert>, t2.b<expand_normal> * zero.b<unsigned_invert>)  [x4]
//    final rgb  : zero.rgb * zero.rgb + (1 - zero.rgb) * zero.rgb + r0.rgb
//    final alpha: r0.a
