// ---------------------------------------------------------------------------

struct VertOut
{
    float4 position    : POSITION;
    float4 color0      : COLOR0;
    float4 color1      : COLOR1;
    float4 texcoord0   : TEXCOORD0;
    float4 texcoord1   : TEXCOORD1;
    float4 texcoord2   : TEXCOORD2;
    float4 texcoord3   : TEXCOORD3;
    float  fog         : TEXCOORD7;
};

float4 main(VertOut IN, uniform sampler2D tex0, uniform sampler2D tex1, uniform samplerCUBE tex2, uniform samplerCUBE tex3, uniform float4 psc[18], uniform float4 xv_fogcolor) : COLOR
{
